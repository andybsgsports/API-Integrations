# ─────────────────────────────────────────────────────────────────────────────
# SanMar → NetSuite integration configuration
# Copy to `.env` and fill in. NEVER commit the real .env (see .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── SanMar SFTP (product data files) ────────────────────────────────────────
# Host/port from the SanMar onboarding email. Credentials are the FTP creds
# retrieved from the one-time Bitwarden Send link — these are DIFFERENT from
# your sanmar.com web-services login.
SANMAR_SFTP_HOST=ftp.sanmar.com
SANMAR_SFTP_PORT=2200
SANMAR_SFTP_USERNAME=298728            # your SanMar customer number
SANMAR_SFTP_PASSWORD=
# Remote directory holding the daily product files (SanMar_SDL_N.csv, etc.)
SANMAR_SFTP_REMOTE_DIR=/SanMarPDD
# Optional: pin the host key fingerprint for strict verification (recommended).
# Leave blank to auto-accept on first connect (AutoAddPolicy).
SANMAR_SFTP_HOST_KEY=

# Local working directory for downloaded files
SANMAR_DOWNLOAD_DIR=./downloads

# ── NetSuite SuiteTalk REST (Token-Based Auth / OAuth 1.0a) ──────────────────
# Create an Integration record (Setup > Integration > Manage Integrations) for
# the consumer key/secret, and an Access Token (Setup > Users/Roles > Access
# Tokens) for the token key/secret. ACCOUNT_ID is your realm, e.g. 1234567 or
# 1234567_SB1 for a sandbox (lowercase, '_' → '-' in the REST host).
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
# REST base is derived from the account id, but can be overridden here.
# NETSUITE_REST_BASE=https://1234567.suitetalk.api.netsuite.com

# SANDBOX-FIRST SAFETY: the integration refuses to connect to a non-sandbox
# (production) account unless this is explicitly set to true. Sandbox realms
# look like 1234567_SB1. Keep this false until sandbox testing is signed off.
NETSUITE_ALLOW_PRODUCTION_WRITES=false

# ── NetSuite record/field mapping ───────────────────────────────────────────
# Internal id of the NetSuite vendor record for SanMar (Lists > Vendors).
NETSUITE_SANMAR_VENDOR_ID=
# Internal id of the subsidiary new items belong to (OneWorld accounts).
NETSUITE_SUBSIDIARY_ID=
# Internal id of the default income account / asset account for new items.
NETSUITE_INCOME_ACCOUNT_ID=
NETSUITE_ASSET_ACCOUNT_ID=
NETSUITE_COGS_ACCOUNT_ID=

# Custom item field ids that hold SanMar-specific data. Create these in
# NetSuite (Customization > Lists,Records,Fields > Item Fields) and map here.
# Defaults below follow a custitem_sanmar_* naming convention.
NS_FIELD_SANMAR_UNIQUE_KEY=custitem_sanmar_unique_key
NS_FIELD_SANMAR_INVENTORY_KEY=custitem_sanmar_inventory_key
NS_FIELD_SANMAR_SIZE_INDEX=custitem_sanmar_size_index
NS_FIELD_SANMAR_STYLE=custitem_sanmar_style
NS_FIELD_SANMAR_MAINFRAME_COLOR=custitem_sanmar_mf_color
NS_FIELD_SANMAR_GTIN=custitem_sanmar_gtin
NS_FIELD_SANMAR_MAP=custitem_sanmar_map
NS_FIELD_SANMAR_MSRP=custitem_sanmar_msrp
NS_FIELD_SANMAR_CASE_PRICE=custitem_sanmar_case_price
NS_FIELD_SANMAR_CASE_SIZE=custitem_sanmar_case_size
NS_FIELD_SANMAR_PRODUCT_STATUS=custitem_sanmar_status
NS_FIELD_SANMAR_QTY_AVAILABLE=custitem_sanmar_qty_available
NS_FIELD_SANMAR_QTY_BY_WHSE=custitem_sanmar_qty_by_whse
NS_FIELD_SANMAR_FRONT_IMAGE_URL=custitem_sanmar_front_image_url
NS_FIELD_SANMAR_IMAGE_FILE=custitem_sanmar_image

# Price level internal ids (Setup > Accounting > Price Levels).
# Base price (level 1) receives the piece price by default.
NETSUITE_PRICE_LEVEL_BASE=1
# Optional extra price levels for case price / MSRP. Leave blank to skip.
NETSUITE_PRICE_LEVEL_CASE=
NETSUITE_PRICE_LEVEL_MSRP=

# ── S&S Activewear REST API ──────────────────────────────────────────────────
# Get the API key from your S&S Account Manager (also retrievable via a
# Freshservice ticket to S&S support). Username = your S&S account number;
# password = the API key. Same key works for the REST API and PromoStandards.
SS_API_BASE_URL=https://api.ssactivewear.com/v2
SS_API_ACCOUNT_NUMBER=
SS_API_KEY=
SS_API_TIMEOUT=60
SS_API_PAGE_SIZE=500
# Local working dir for downloaded catalog snapshots (separate from SanMar)
SS_DOWNLOAD_DIR=./downloads/ss

# Internal id of the NetSuite vendor record for S&S (Lists > Vendors).
NETSUITE_SS_VENDOR_ID=
# Optional File Cabinet folder id used by `ss-sync sync-images` (future).
NETSUITE_SS_IMAGE_FOLDER_ID=

# S&S custom item fields. Defaults follow a custitem_ss_* naming convention.
NS_FIELD_SS_SKU=custitem_ss_sku
NS_FIELD_SS_STYLE_ID=custitem_ss_style_id
NS_FIELD_SS_STYLE=custitem_ss_style
NS_FIELD_SS_COLOR_NAME=custitem_ss_color_name
NS_FIELD_SS_COLOR_CODE=custitem_ss_color_code
NS_FIELD_SS_SIZE_NAME=custitem_ss_size_name
NS_FIELD_SS_SIZE_ORDER=custitem_ss_size_order
NS_FIELD_SS_GTIN=custitem_ss_gtin
NS_FIELD_SS_BRAND=custitem_ss_brand
NS_FIELD_SS_MAP=custitem_ss_map
NS_FIELD_SS_MSRP=custitem_ss_msrp
NS_FIELD_SS_PIECE_PRICE=custitem_ss_piece_price
NS_FIELD_SS_DOZEN_PRICE=custitem_ss_dozen_price
NS_FIELD_SS_CASE_PRICE=custitem_ss_case_price
NS_FIELD_SS_CASE_SIZE=custitem_ss_case_size
NS_FIELD_SS_WEIGHT=custitem_ss_weight
NS_FIELD_SS_QTY_AVAILABLE=custitem_ss_qty_available
NS_FIELD_SS_QTY_BY_WHSE=custitem_ss_qty_by_whse
NS_FIELD_SS_IS_CLOSEOUT=custitem_ss_is_closeout
NS_FIELD_SS_IS_DISCONTINUED=custitem_ss_is_discontinued
NS_FIELD_SS_FRONT_IMAGE_URL=custitem_ss_front_image_url
NS_FIELD_SS_ON_MODEL_IMAGE_URL=custitem_ss_on_model_image_url

# ── Sync behavior ────────────────────────────────────────────────────────────
# SQLite delta-cache path: records unchanged since last push are skipped.
STATE_DB_PATH=./state/sync_state.db
# Cap on records processed per run (0 = no limit). Useful for first test runs.
SYNC_MAX_RECORDS=0
# Dry run: parse + transform + log payloads, but do not call NetSuite.
SYNC_DRY_RUN=true
# Tax Schedule written into the matrix-item import CSV (NetSuite requires one on
# inventory items). SanMar apparel is taxable; set to your account's taxable
# schedule name exactly as it appears in NetSuite.
SYNC_TAX_SCHEDULE=Taxable
# Income account for matrix items, by account NUMBER (CSV import resolves
# numbers reliably; names do not).
SYNC_INCOME_ACCOUNT=4100
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
